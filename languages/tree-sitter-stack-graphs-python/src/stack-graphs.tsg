;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Stack graphs definition for Python
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Global Variables
;; ^^^^^^^^^^^^^^^^

global FILE_PATH
global ROOT_PATH = ""
global ROOT_NODE
global JUMP_TO_SCOPE_NODE

;; Attribute Shorthands
;; ^^^^^^^^^^^^^^^^^^^^

attribute node_definition = node        => type = "pop_symbol", node_symbol = node, is_definition
attribute node_reference = node         => type = "push_symbol", node_symbol = node, is_reference
attribute pop_node = node               => type = "pop_symbol", node_symbol = node
attribute pop_scoped_node = node        => type = "pop_scoped_symbol", node_symbol = node
attribute pop_scoped_symbol = symbol    => type = "pop_scoped_symbol", symbol = symbol
attribute pop_symbol = symbol           => type = "pop_symbol", symbol = symbol
attribute push_node = node              => type = "push_symbol", node_symbol = node
attribute push_scoped_node = node       => type = "push_scoped_symbol", node_symbol = node
attribute push_scoped_symbol = symbol   => type = "push_scoped_symbol", symbol = symbol
attribute push_symbol = symbol          => type = "push_symbol", symbol = symbol
attribute scoped_node_definition = node => type = "pop_scoped_symbol", node_symbol = node, is_definition
attribute scoped_node_reference = node  => type = "push_scoped_symbol", node_symbol = node, is_reference
attribute symbol_definition = symbol    => type = "pop_symbol", symbol = symbol, is_definition
attribute symbol_reference = symbol     => type = "push_symbol", symbol = symbol, is_reference

attribute node_symbol = node            => symbol = (source-text node), source_node = node

;; Nodes
;; ^^^^^

(module) @node {
  node @node.after_scope
  node @node.before_scope
}

[
  ; _statement
  ; _simple_statement
  (future_import_statement)
  (import_statement)
  (import_from_statement)
  (print_statement)
  (assert_statement)
  (expression_statement)
  (return_statement)
  (delete_statement)
  (raise_statement)
  (pass_statement)
  (break_statement)
  (continue_statement)
  (global_statement)
  (nonlocal_statement)
  (exec_statement)
  (type_alias_statement)
  ; _compound_statement
  (if_statement)
  (for_statement)
  (while_statement)
  (try_statement)
  (with_statement)
  (function_definition)
  (class_definition)
  (decorated_definition)
  (match_statement)
  ; block
  (block)
  ; statement clauses
  (if_clause)
  (elif_clause)
  (else_clause)
  (except_group_clause)
  (except_clause)
  (finally_clause)
  (with_clause)
  (case_clause)
] @node {
  node @node.after_scope
  node @node.before_scope
}

[
  (parameters)
  (lambda_parameters)
] @node {
  node @node.after_scope
  node @node.before_scope
}

[
  (identifier)
] @node {
  node @node.def
  node @node.def_dot
  node @node.ref
  node @node.ref_dot
}

[
  (dotted_name)
  (aliased_import)
  (relative_import)
  (wildcard_import)
  (import_prefix)
] @node {
  node @node.after_scope
  node @node.before_scope
  node @node.def
  node @node.ref
}

[
  ; expressions
  (comparison_operator)
  (not_operator)
  (boolean_operator)
  (lambda)
  ;(primary_expression) ; unfolded below
  (conditional_expression)
  (named_expression)
  (as_pattern)
  ; primary_expression
  (await)
  (yield)
  (binary_operator)
  (identifier)
  ;(keyword_identifier) ; invalid query pattern?
  (string)
  (concatenated_string)
  (integer)
  (float)
  (true)
  (false)
  (none)
  (unary_operator)
  (attribute)
  (subscript)
  (call)
  (list)
  (list_comprehension)
  (dictionary)
  (dictionary_comprehension)
  (set)
  (set_comprehension)
  (tuple)
  (pair)
  (parenthesized_expression)
  (generator_expression)
  (ellipsis)
  (list_splat)

  ; expression list
  (expression_list)

  ; pattern
  (pattern/identifier)
  ;(keyword_identifier) ; invalid query pattern?
  ;(subscript)
  ;(attribute)
  (list_splat_pattern)
  (tuple_pattern)
  (list_pattern)
  ; _simple_patterns
  (class_pattern)
  (splat_pattern)
  (union_pattern)
  ;(list_pattern) ; already in pattern
  ;(tuple_pattern) ; already in pattern
  (dict_pattern)
  ;(string) ; already in primary_expression
  ;(concatenated_string) ; already in primary_expression
  ;(true) ; already in primary_expression
  ;(false) ; already in primary_expression
  ;(none) ; already in primary_expression
  ;(integer) ; already in primary_expression
  ;(float) ; already in primary_expression
  (complex_pattern)
  (dotted_name)
  ; _as_attern
  (as_pattern)
  ; keyword pattern
  (keyword_pattern)
  ; case pattern
  (case_pattern)
  ; with item
  (with_item)

  ; assignment
  (assignment)

  ; pattern list
  (pattern_list)

  ; parameter
  ;(identifier) ; already in expressions
  (typed_parameter)
  (default_parameter)
  (typed_default_parameter)
  ;(list_splat_pattern) ; already in patterns
  ;(tuple_pattern) ; already in patterns
  (keyword_separator)
  (positional_separator)
  (dictionary_splat_pattern)

  ; parameters
  (parameters)
] @node {
  node @node.input
  node @node.new_bindings
  node @node.output
}

(comment) @node {
  node @node.after_scope
  node @node.before_scope
  node @node.def
  node @node.def_dot
  node @node.input
  node @node.new_bindings
  node @node.output
  node @node.ref
  node @node.ref_dot
}

;; Inherited Variables
;; ^^^^^^^^^^^^^^^^^^^

inherit .bottom
inherit .bottom_precedence
inherit .local_precedence
inherit .class_member_attr_scope
inherit .class_parent_scope
inherit .class_self_scope
inherit .class_super_scope
inherit .declared_names
inherit .enclosing_scope
inherit .function_returns
inherit .global
inherit .global_dot
inherit .relative_entry
inherit .binding_scope
inherit .declaration
inherit .literal_scope
inherit .local_scope
inherit .type_param_scope

;;
;; #     #
;; ##   ##  ####  #####  #    # #      ######  ####
;; # # # # #    # #    # #    # #      #      #
;; #  #  # #    # #    # #    # #      #####   ####
;; #     # #    # #    # #    # #      #           #
;; #     # #    # #    # #    # #      #      #    #
;; #     #  ####  #####   ####  ###### ######  ####
;;
;; Modules

(module) @mod
{
  node mod_file_def
  node mod_file_ref

  var module_def = mod_file_def

  node parent_module_def_node
  var parent_module_def = parent_module_def_node

  var module_ref = mod_file_ref

  ; The relative imports climb through the packages that hold the file. See "Relative Imports".
  ; The node `up_n` for the package at depth n pops one "<up>" marker, then leads to `up_n-1` and to
  ; the references of the package at depth n. The depth 0 node has no pop.
  node up_dead_end
  var up_node = up_dead_end

  ; get the file path relative to the root path
  let rel_path = (replace FILE_PATH ROOT_PATH "")
  scan rel_path {
    "([^/]+)/"
    {
      node def_dot
      attr (def_dot) pop_symbol = "."
      node next_def
      ;
      edge module_def -> def_dot
      edge def_dot -> next_def
      ;
      attr (module_def) pop_symbol = $1
      ;
      set parent_module_def = module_def
      set module_def = next_def

      node ref_dot
      attr (ref_dot) push_symbol = "."
      node next_ref
      ;
      edge next_ref -> ref_dot
      edge ref_dot -> module_ref
      ;
      attr (module_ref) push_symbol = $1
      ;
      ; `module_ref` is the reference to the package of the first (i - 1) directories.
      node up_next
      edge up_next -> module_ref
      node up_pop
      attr (up_pop) pop_symbol = "<up>"
      edge up_next -> up_pop
      edge up_pop -> up_node
      set up_node = up_next
      set module_ref = next_ref
    }

    "__init__\.py$"
    {
      attr (parent_module_def) is_definition, source_node = @mod, empty_source_span
    }

    "([^/]+)\.py$"
    {
      node def_dot
      attr (def_dot) pop_symbol = "."
      node next_def
      ;
      edge module_def -> def_dot
      edge def_dot -> next_def
      ;
      attr (module_def) pop_symbol = $1, is_definition, source_node = @mod, empty_source_span
      ;
      set module_def = next_def
    }

    ; The loader names the builtins file "<builtins>", with no ".py" suffix.
    ; Define it as module "<builtins>", so the global scope of every file can reach it.
    "^<builtins>$"
    {
      node def_dot
      attr (def_dot) pop_symbol = "."
      node next_def
      ;
      edge module_def -> def_dot
      edge def_dot -> next_def
      ;
      attr (module_def) pop_symbol = "<builtins>", is_definition, source_node = @mod, empty_source_span
      ;
      set module_def = next_def
    }
  }

  edge ROOT_NODE -> mod_file_def
  edge mod_file_ref -> ROOT_NODE
  edge module_def -> @mod.after_scope

  node global
  node global_dot

  edge @mod.before_scope -> global_dot
  edge global -> ROOT_NODE
  attr (global) push_symbol = "<builtins>"

  edge global_dot -> global
  attr (global_dot) push_symbol = "."

  ; The entry of a relative import. It pops one marker for each dot of the import.
  node up_entry
  node up_entry_pop
  attr (up_entry_pop) pop_symbol = "<up>"
  edge up_entry -> up_entry_pop
  edge up_entry_pop -> up_node
  let @mod.relative_entry = up_entry
  let @mod.bottom = @mod.after_scope
  ; The final bindings of the module shadow the bindings that precede a top-level function.
  let @mod.bottom_precedence = 1
  ; The bindings that precede a top-level function have the lowest precedence.
  let @mod.local_precedence = 0
  let @mod.global = global
  let @mod.global_dot = global_dot

  ;; add a dummy nodes for inherited variables
  node @mod.class_member_attr_scope
  node @mod.class_parent_scope
  node @mod.class_self_scope
  node @mod.class_super_scope
  node @mod.function_returns
  node @mod.local_scope
  node @mod.binding_scope
  node @mod.declared_names
  node @mod.type_param_scope
  let @mod.declaration = #false
  node @mod.enclosing_scope

  ;; the scope that a literal pushes with the "()" symbol of its class
  node @mod.literal_scope
  attr (@mod.literal_scope) is_exported
}

;;
;; ###
;;  #  #    # #####   ####  #####  #####  ####
;;  #  ##  ## #    # #    # #    #   #   #
;;  #  # ## # #    # #    # #    #   #    ####
;;  #  #    # #####  #    # #####    #        #
;;  #  #    # #      #    # #   #    #   #    #
;; ### #    # #       ####  #    #   #    ####
;;
;; Imports

;; Import References
;; ^^^^^^^^^^^^^^^^^

;;;; Dotted Names
;;
;; (dotted_name).ref              node to connect to to use the reference
;; (dotted_name).before_scope     node to connect from to ensure the reference resolves

;; all names are references
[
  (import_statement        name:                       (dotted_name (identifier) @name))
  (future_import_statement name:                       (dotted_name (identifier) @name))
  (import_from_statement   name:                       (dotted_name (identifier) @name))
  (import_statement        name: (aliased_import name: (dotted_name (identifier) @name)))
  (future_import_statement name: (aliased_import name: (dotted_name (identifier) @name)))
  (import_from_statement   name: (aliased_import name: (dotted_name (identifier) @name)))
  (import_from_statement module_name:                  (dotted_name (identifier) @name))
  (import_from_statement module_name: (relative_import (dotted_name (identifier) @name)))
] {
  attr (@name.ref) node_reference = @name
}

;; references are chained
[
  (import_statement        name:                       (dotted_name (identifier) @left . (identifier) @right))
  (future_import_statement name:                       (dotted_name (identifier) @left . (identifier) @right))
  (import_from_statement   name:                       (dotted_name (identifier) @left . (identifier) @right))
  (import_statement        name: (aliased_import name: (dotted_name (identifier) @left . (identifier) @right)))
  (future_import_statement name: (aliased_import name: (dotted_name (identifier) @left . (identifier) @right)))
  (import_from_statement   name: (aliased_import name: (dotted_name (identifier) @left . (identifier) @right)))
  (import_from_statement module_name:                  (dotted_name (identifier) @left . (identifier) @right))
  (import_from_statement module_name: (relative_import (dotted_name (identifier) @left . (identifier) @right)))
] {
  node push_dot
  attr (push_dot) push_symbol = "."

  edge @right.ref -> push_dot
  edge push_dot -> @left.ref
}

;; lookup first reference
[
  (import_statement        name:                       (dotted_name . (identifier) @first) @dotted)
  (future_import_statement name:                       (dotted_name . (identifier) @first) @dotted)
  (import_from_statement   name:                       (dotted_name . (identifier) @first) @dotted)
  (import_statement        name: (aliased_import name: (dotted_name . (identifier) @first) @dotted))
  (future_import_statement name: (aliased_import name: (dotted_name . (identifier) @first) @dotted))
  (import_from_statement   name: (aliased_import name: (dotted_name . (identifier) @first) @dotted))
  (import_from_statement module_name:                  (dotted_name . (identifier) @first) @dotted)
  (import_from_statement module_name: (relative_import (dotted_name . (identifier) @first) @dotted))
] {
  edge @first.ref -> @dotted.before_scope
}

;; expose last reference
[
  (import_statement        name:                       (dotted_name (identifier) @last .) @dotted)
  (future_import_statement name:                       (dotted_name (identifier) @last .) @dotted)
  (import_from_statement   name:                       (dotted_name (identifier) @last .) @dotted)
  (import_statement        name: (aliased_import name: (dotted_name (identifier) @last .) @dotted))
  (future_import_statement name: (aliased_import name: (dotted_name (identifier) @last .) @dotted))
  (import_from_statement   name: (aliased_import name: (dotted_name (identifier) @last .) @dotted))
  (import_from_statement module_name:                  (dotted_name (identifier) @last .) @dotted)
  (import_from_statement module_name: (relative_import (dotted_name (identifier) @last .) @dotted))
] {
  edge @dotted.ref -> @last.ref
}

;;;; Aliased Import
;;
;; An aliased import behaves like its wrapped dotted_name as a reference
;;
;; (aliased_import).ref              node to connect to, to use the reference
;; (aliased_import).before_scope     node to connect from to ensure the reference resolves

(aliased_import name: (dotted_name) @dotted) @aliased {
  edge @aliased.ref -> @dotted.ref
  edge @dotted.before_scope -> @aliased.before_scope
}

;;;; Relative Import
;;
;; A relative import behaves like its wrapped dotted_name as a reference
;;
;; (relative_import).ref              node to connect to, to use the reference
;; (relative_import).before_scope     node to connect from to ensure the reference resolves

(relative_import (import_prefix) . (dotted_name) @dotted) @relative {
  edge @relative.ref -> @dotted.ref

  node push_dot
  attr (push_dot) push_symbol = "."

  edge @dotted.before_scope -> push_dot
  edge push_dot -> @relative.before_scope
}

(relative_import (import_prefix) .) @relative {
  edge @relative.ref -> @relative.before_scope
}

;;;; Wildcard Import
;;
;; A wildcard import simply passes through
;;
;; (wildcard_import).ref              node to connect to, to use the reference
;; (wildcard_import).before_scope     node to connect from to ensure the reference resolves

(wildcard_import) @wildcard {
  edge @wildcard.ref -> @wildcard.before_scope
}

;;;; Import from
;;
;; The imported references are resolved in the from module

[
  (import_from_statement module_name: (_) @left name: (_) @right)
  (import_from_statement module_name: (_) @left (wildcard_import) @right)
] {
  node push_dot
  attr (push_dot) push_symbol = "."

  edge @right.before_scope -> push_dot
  edge push_dot -> @left.ref
}

;;;; Non-relative Imports
;;
;; Non-relative imports are resolved in the root scope

[
  (import_statement      name:        (_) @name)
  (import_from_statement module_name: (dotted_name) @name)
] {
  edge @name.before_scope -> ROOT_NODE
}

;;;; Relative Imports
;;
;; Relative imports are resolved in scopes related to the current module

;; A relative import with N dots starts in the Nth package above the file. A `.` names the package
;; of the file, and each further dot goes one package up. The import pushes one "<up>" marker for
;; each dot, then goes to the entry of the module. The module pops one marker at each level and
;; stops at the package that the markers name. An import that climbs above the root has too many
;; markers, so it does not resolve.
(import_from_statement module_name: (relative_import (import_prefix) @prefix) @relative) {
  var up = @relative.before_scope
  scan (source-text @prefix) {
    "\\."
    {
      node push_up
      attr (push_up) push_symbol = "<up>"
      edge up -> push_up
      set up = push_up
    }
  }
  edge up -> @prefix.relative_entry
}

;;;; Future Imports
;;
;; We don't know the future, so we cannot connect references of future imports anywhere. Maybe one day?

;; Import Definitions
;; ^^^^^^^^^^^^^^^^^^

;;;; Dotted Names & Aliased Imports
;;
;; (dotted_name).after_scope     node to connect to, to expose the definition
;; (dotted_name).def             node to connect from, to give definition content

;; unaliased names and aliases are definitions
[
  (import_statement        name:           (dotted_name (identifier) @name))
  (future_import_statement name:           (dotted_name (identifier) @name))
  (import_from_statement   name:           (dotted_name (identifier) @name))
  (import_statement        name: (aliased_import alias: (identifier) @name))
  (future_import_statement name: (aliased_import alias: (identifier) @name))
  (import_from_statement   name: (aliased_import alias: (identifier) @name))
] {
  attr (@name.def) node_definition = @name
}

;; definitions are chained
[
  (import_statement        name: (dotted_name (identifier) @left . (identifier) @right))
  (future_import_statement name: (dotted_name (identifier) @left . (identifier) @right))
  (import_from_statement   name: (dotted_name (identifier) @left . (identifier) @right))
] {
  node pop_dot
  attr (pop_dot) pop_symbol = "."

  edge @left.def -> pop_dot
  edge pop_dot -> @right.def
}

;; connect last definition
[
  (import_statement        name:           (dotted_name (identifier) @last .) @outer)
  (future_import_statement name:           (dotted_name (identifier) @last .) @outer)
  (import_from_statement   name:           (dotted_name (identifier) @last .) @outer)
  (import_statement        name: (aliased_import alias: (identifier) @last  ) @outer)
  (future_import_statement name: (aliased_import alias: (identifier) @last  ) @outer)
  (import_from_statement   name: (aliased_import alias: (identifier) @last  ) @outer)
] {
  edge @last.def -> @outer.def
}

;; expose first definition
[
  (import_statement        name:           (dotted_name . (identifier) @first) @outer)
  (future_import_statement name:           (dotted_name . (identifier) @first) @outer)
  (import_from_statement   name:           (dotted_name . (identifier) @first) @outer)
  (import_statement        name: (aliased_import alias:   (identifier) @first  ) @outer)
  (future_import_statement name: (aliased_import alias:   (identifier) @first  ) @outer)
  (import_from_statement   name: (aliased_import alias:   (identifier) @first  ) @outer)
] {
  edge @outer.after_scope -> @first.def
}

;;;; Package Name
;;
;; `import a.b.c` binds the name `a` to the package `a`. The submodules `b` and `c` are members of
;; the package. A use of `a` alone, as in `a.b.c.X` or `a.foo`, resolves in the package `a`, and it
;; reaches the submodules `b` and `c` as members. The definition of `a` continues to the module
;; reference `a`.

(import_statement
  name: (dotted_name . (identifier) @first . (identifier)))
{
  edge @first.def -> @first.ref
}

;;;; Wildcard Import
;;
;; Wildcard imports simply pass through

(wildcard_import) @wildcard {
  edge @wildcard.after_scope -> @wildcard.def
}

;;;; Import Definitions -> References
;;
;; The definitions introduced by imports are connected to the corresponding references

[
  (import_statement        name: (_) @name)
  (future_import_statement name: (_) @name)
  (import_from_statement   name: (_) @name)
  (import_from_statement   (wildcard_import) @name)
] {
  edge @name.def -> @name.ref
}

;;;; Imports
;;
;; The definitions introduced by imports are visible after the import statement

[
  (import_statement        name: (_) @name)
  (future_import_statement name: (_) @name)
  (import_from_statement   name: (_) @name)
  (import_from_statement   (wildcard_import) @name)
] @stmt {
  edge @stmt.after_scope -> @name.after_scope
  attr (@stmt.after_scope -> @name.after_scope) precedence = 1
}

;;
;; ######
;; #     # #       ####   ####  #    #  ####
;; #     # #      #    # #    # #   #  #
;; ######  #      #    # #      ####    ####
;; #     # #      #    # #      #  #        #
;; #     # #      #    # #    # #   #  #    #
;; ######  ######  ####   ####  #    #  ####
;;
;; Blocks

[
  (module (_) @last_stmt .)
  (block (_) @last_stmt .)
] @block
{
  edge @block.after_scope -> @last_stmt.after_scope
}

[
  (module (_) @stmt1 . (_) @stmt2)
  (block (_) @stmt1 . (_) @stmt2)
]
{
  edge @stmt2.before_scope -> @stmt1.after_scope
}

[
  (module (_) @stmt)
  (block (_) @stmt)
]
{
  ; A statement lets the bindings before it flow past it. This holds for each statement, except an
  ; `if` statement with an `else` clause. In that statement, every branch can bind a name, so the
  ; bindings before the statement are not reachable after it, unless a branch passes them through.
  ; Each branch passes the bindings before the statement through itself. A `try` statement with a
  ; handler keeps the edge, as the body of the `try` can stop at any point.
  ;
  ; The path stitcher must find the path through each branch. Take a branch that binds the name,
  ; like `x = 1`, and a branch that does not. The path through the first branch passes the earlier
  ; binding with a lower precedence, so its own binding shadows that path. The path through the
  ; second branch is not shadowed. Both paths join at the node before the statement, and they are
  ; similar. The detector of similar paths keeps the first of them by default. It can keep the
  ; path that the binding shadows, and lose the earlier binding that the second branch reaches.
  ; So the language configuration turns on shadow aware detection of similar paths. Every stitcher
  ; that resolves these graphs must do so. Without it, a name can lose a binding.
  if (not (eq (node-type @stmt) "if_statement")) {
    edge @stmt.after_scope -> @stmt.before_scope
  }
  let @stmt.local_scope = @stmt.before_scope
  let @stmt.binding_scope = @stmt.before_scope
}

; An `if` statement without `else` keeps the edge.
(if_statement !alternative) @stmt
{
  edge @stmt.after_scope -> @stmt.before_scope
}

(if_statement alternative: (elif_clause) .) @stmt
{
  edge @stmt.after_scope -> @stmt.before_scope
}

[
  (block . (_) @stmt)
  (module . (_) @stmt)
] @block
{
  edge @stmt.before_scope -> @block.before_scope
}

(function_definition (block) @block) @func
{
  edge @block.before_scope -> @block.local_scope
  ; A function inside another function sees the bindings of the enclosing function before the final
  ; bindings of the module. A top-level function sees the final bindings of the module first.
  attr (@block.before_scope -> @block.local_scope) precedence = @func.local_precedence
}

[
  (while_statement (block) @block)
  (if_statement (block) @block)
  (with_statement (block) @block)
  (try_statement (block) @block)
  (for_statement (block) @block)
  (_ [
    (else_clause (block) @block)
    (elif_clause (block) @block)
    (except_clause (block) @block)
    (finally_clause (block) @block)
  ])
] @stmt
{
  edge @block.before_scope -> @block.local_scope
  edge @stmt.after_scope -> @block.after_scope
}

(match_statement body: (_) @block) @stmt
{
  let @block.local_scope = @block.before_scope
  let @block.binding_scope = @block.before_scope
  edge @block.before_scope -> @stmt.before_scope
  edge @stmt.after_scope -> @block.after_scope
}

[
  (for_statement)
  (while_statement)
] @stmt
{
  edge @stmt.before_scope -> @stmt.after_scope
}

;;
;;  #####
;; #     # #####   ##   ##### ###### #    # ###### #    # #####  ####
;; #         #    #  #    #   #      ##  ## #      ##   #   #   #
;;  #####    #   #    #   #   #####  # ## # #####  # #  #   #    ####
;;       #   #   ######   #   #      #    # #      #  # #   #        #
;; #     #   #   #    #   #   #      #    # #      #   ##   #   #    #
;;  #####    #   #    #   #   ###### #    # ###### #    #   #    ####
;;
;; Statements

;;;; Simple Statements

(print_statement) {}

(assert_statement) {}

(expression_statement) {}

(return_statement (_) @expr) @stmt
{
  edge @stmt.function_returns -> @expr.output
}

(delete_statement) {}

(raise_statement) {}

(pass_statement) {}

(break_statement) {}

(continue_statement) {}

;;;; Global and nonlocal names
;;
;; `global x` in a function makes `x` a name of the module, and `nonlocal x` makes it a name of the
;; enclosing function. An assignment to `x` in the function then binds that name, not a new local.
;; Each function has a scope of declared names. A reference in the function looks there first,
;; with a precedence above all other scopes. The scope pops the name and looks it up again in the
;; final bindings of the module, or in the scope of the enclosing function at its definition.
;; The name in the statement is a reference to the same binding.
;;
;; The assignment in the function still makes a definition of a local. The rules cannot drop it,
;; but no reference reaches it. An assignment in the same block as the statement is a reference
;; too, so that its name also names the declared binding.

[
  (global_statement (identifier) @name) @stmt
  (nonlocal_statement (identifier) @name) @stmt
]
{
  node pop
  node push
  node reference
  attr (pop) pop_symbol = (source-text @name)
  attr (push) push_symbol = (source-text @name)
  attr (reference) node_reference = @name
  edge @stmt.declared_names -> pop
  edge pop -> push
  if (eq (node-type @stmt) "global_statement") {
    edge push -> @stmt.bottom
    edge reference -> @stmt.bottom
  } else {
    edge push -> @stmt.enclosing_scope
    edge reference -> @stmt.enclosing_scope
  }
}

(block
  [
    (global_statement (identifier) @_declared)
    (nonlocal_statement (identifier) @_declared)
  ]
  (expression_statement (assignment left: (identifier) @name))
  (#eq? @_declared @name))
{
  node reference
  attr (reference) node_reference = @name
  edge reference -> @name.declared_names
}

(exec_statement) {}

;;;; Type parameters and type aliases
;;
;; The type parameters of a class, a function, or a type alias, as in `class C[T: Base]`, belong to
;; a scope of their own. The scope covers the whole definition: the parameters, the annotations, the
;; base classes, and the body. It does not cover the decorators. A reference to a type parameter
;; resolves in that scope before every other scope, so a module level `T` stays out.
;;
;; (_).type_param_scope  the scope of the type parameters around a node
;; (_).declaration       true at the declaration of a type parameter or of a type alias

(type_alias_statement) {}

[
  (function_definition type_parameters: (type_parameter))
  (class_definition type_parameters: (type_parameter))
  (type_alias_statement . (type (generic_type (type_parameter))))
] @owner
{
  node @owner.tp_scope
  ; A type parameter is visible in the definitions inside the definition that has it.
  edge @owner.tp_scope -> @owner.type_param_scope
}

[
  (function_definition type_parameters: (type_parameter) (_) @child)
  (class_definition type_parameters: (type_parameter) (_) @child)
  (type_alias_statement . (type (generic_type (type_parameter))) (_) @child)
] @owner
{
  let @child.type_param_scope = @owner.tp_scope
}

;; The names in the list are declarations. The bound of a name is an ordinary expression.
[
  (function_definition type_parameters: (type_parameter) @list)
  (class_definition type_parameters: (type_parameter) @list)
  (type_alias_statement . (type) @list)
]
{
  let @list.declaration = #true
}

[
  (function_definition type_parameters: (type_parameter (type (constrained_type (type) . (type) @bound))))
  (class_definition type_parameters: (type_parameter (type (constrained_type (type) . (type) @bound))))
  (type_alias_statement . (type (generic_type (type_parameter (type (constrained_type (type) . (type) @bound))))))
]
{
  let @bound.declaration = #false
}

[
  (function_definition type_parameters: (type_parameter (type [
    (identifier) @name
    (constrained_type . (type (identifier) @name))
    (splat_type (identifier) @name)
  ])) ) @owner
  (class_definition type_parameters: (type_parameter (type [
    (identifier) @name
    (constrained_type . (type (identifier) @name))
    (splat_type (identifier) @name)
  ])) ) @owner
  (type_alias_statement . (type (generic_type (type_parameter (type [
    (identifier) @name
    (constrained_type . (type (identifier) @name))
    (splat_type (identifier) @name)
  ]))))) @owner
]
{
  attr (@name.def) node_definition = @name
  edge @owner.tp_scope -> @name.def
}

;; `type Name = value` and `type Name[T] = value` define `Name` in the enclosing scope.
(type_alias_statement
  . (type [
    (identifier) @name
    (generic_type . (identifier) @name)
  ])) @stmt
{
  attr (@name.def) node_definition = @name
  attr (@name.def) definiens_node = @stmt
  edge @stmt.after_scope -> @name.def
  attr (@stmt.after_scope -> @name.def) precedence = 1
}

;;;; Compound Statements

(if_statement) {}

(if_clause) {}

(elif_clause) {}

(else_clause) {}

(for_statement) {}

(while_statement) {}

(try_statement) {}

(except_group_clause) {}

(except_clause) {}

(finally_clause) {}

(with_statement) {}

(with_clause) {}

(function_definition
  parameters: (_) @params
  body: (_) @body
) @func {
  node @func.call
  node return_value
  node drop_scope

  edge @func.call -> return_value
  edge @body.before_scope -> @params.after_scope
  ; A parameter shadows a name from an outer scope, and the final bindings of the module.
  attr (@body.before_scope -> @params.after_scope) precedence = 2
  ; The body sees the final bindings of the module, as the function can run after them. At a
  ; top-level function, they shadow the bindings that precede the function and the builtins.
  ; This way a module-level definition after the function shadows a builtin of the same name.
  ; A function inside another function keeps both, as a name of the enclosing function must win.
  edge @body.before_scope -> drop_scope
  attr (@body.before_scope -> drop_scope) precedence = @func.bottom_precedence
  let @body.bottom_precedence = 0
  ; In a function, the enclosing bindings win over the final bindings of the module.
  let @body.local_precedence = 1
  edge drop_scope -> @func.bottom
  attr (drop_scope) type = "drop_scopes"
  ; The names that a `global` or `nonlocal` statement in the body declares.
  node @body.declared_names
  let @body.enclosing_scope = @func.local_scope
  attr (@func.call) pop_scoped_symbol = "()"
  edge @params.before_scope -> JUMP_TO_SCOPE_NODE
  attr (return_value) is_exported
  let @func.function_returns = return_value
}

(lambda
  body: (_) @body
) @lam {
  node @lam.call
  node return_value
  node @body.after_scope

  edge @lam.call -> return_value
  ; The body sees the final bindings of the module, as the body of a function does, and the
  ; bindings of the enclosing function. A parameter of the lambda shadows both.
  edge @body.after_scope -> @lam.bottom
  attr (@body.after_scope -> @lam.bottom) precedence = @lam.bottom_precedence
  edge @body.after_scope -> @lam.local_scope
  attr (@body.after_scope -> @lam.local_scope) precedence = @lam.local_precedence
  attr (@lam.call) pop_scoped_symbol = "()"
  attr (return_value) is_exported
  let @lam.function_returns = return_value
}

; A lambda without parameters reaches the outer scope directly.
; A lambda with parameters reaches it through the parameters, so that a parameter shadows it.
(lambda
  !parameters
  body: (_) @body
) {
  edge @body.before_scope -> @body.after_scope
}

(lambda
  parameters: (_) @params
  body: (_) @body
) {
  edge @body.before_scope -> @params.after_scope
  edge @params.before_scope -> JUMP_TO_SCOPE_NODE
  edge @params.after_scope -> @body.after_scope
}

(function_definition
  name: (identifier) @name
  body: (_) @body
) @func {
  attr (@name.def) node_definition = @name
  attr (@name.def) definiens_node = @func
  edge @func.after_scope -> @name.def
  ; A function definition shadows an earlier binding of the same name.
  attr (@func.after_scope -> @name.def) precedence = 1
  edge @name.def -> @func.call

  ; Prevent functions defined inside of method bodies from being treated like methods
  let @body.class_self_scope = #null
  let @body.class_member_attr_scope = #null
}

;;;; Keyword arguments
;;
;; The name in `f(name=value)` is a reference to the parameter `name` of the function that the
;; call reaches. The reference pushes the symbol `name` and the marker symbol "<kw>", then it
;; resolves the called expression. A function pops the marker and looks the name up among its
;; parameters. A class looks `__init__` up in its members, and that function pops the marker.

(function_definition
  name: (identifier) @name
  parameters: (_) @params)
{
  node keyword_pop
  attr (keyword_pop) pop_symbol = "<kw>"
  edge @name.def -> keyword_pop
  edge keyword_pop -> @params.keyword_scope
}

; A keyword argument names a parameter by its name. The parameters `*args` and `**kwargs` take
; the arguments that no other parameter takes, so no keyword argument names them.
(parameters) @params
{
  node @params.keyword_scope
}

[
  (parameters (identifier) @name)
  (parameters (default_parameter name: (identifier) @name))
  (parameters (typed_parameter . (identifier) @name))
  (parameters (typed_default_parameter name: (identifier) @name))
] @params
{
  edge @params.keyword_scope -> @name.def
}

(call
  function: (_) @fn
  arguments: (argument_list
    (keyword_argument
      name: (identifier) @name)))
{
  node reference
  node @name.kw_marker
  attr (reference) node_reference = @name
  attr (@name.kw_marker) push_symbol = "<kw>"
  edge reference -> @name.kw_marker
  edge @name.kw_marker -> @fn.output
}

; A call of a generic class, `C[T](name=v)`, calls the class `C`. The subscript has no output of
; its own, so the marker goes to the value of the subscript.
(call
  function: (subscript
    value: (_) @value)
  arguments: (argument_list
    (keyword_argument
      name: (identifier) @name)))
{
  edge @name.kw_marker -> @value.output
}

; method definition
(class_definition
    body: (block
            (function_definition
                name: (identifier) @method_name
                parameters: 
                    (parameters . (identifier) @first_param)
                body: (block) @method_body
            )
         )
) @class
{
  ; The methods `__new__`, `__init_subclass__`, and `__class_getitem__` take the class as the
  ; first parameter, with no decorator.
  if (or (eq (source-text @method_name) "__new__") (or (eq (source-text @method_name) "__init_subclass__") (eq (source-text @method_name) "__class_getitem__"))) {
    edge @first_param.def -> @class.cls_call
    edge @first_param.def -> @class.cls_members_dot
    edge @first_param.def -> @class.cls_keyword_pop
  } else {
    edge @first_param.def -> @first_param.class_self_scope
  }
  edge @first_param.class_member_attr_scope -> @first_param.output
  edge @first_param.output -> @method_body.after_scope
  attr (@first_param.output) push_node = @first_param
}

;; A property. A read of `obj.prop` behaves like a call of the method `prop`, so the result of the
;; method, or its return annotation, gives the type of the read. The read pushes the "()" symbol
;; and the call pops it. Only a read that looks up a member of the result takes this path, so the
;; read of the property alone still resolves to the method only. The decorator is `property`, `cached_property`, or a dotted name that ends
;; in one of these. Any decorator of the method can name the property.
[
  (decorated_definition
    (decorator [
      (identifier) @_decorator
      (attribute attribute: (identifier) @_decorator)
    ])
    definition: (function_definition name: (identifier) @name) @func
    (#match? @_decorator "^(property|cached_property|abstractproperty)$"))
]
{
  node property_pop_dot
  node property_push_dot
  node property_call
  attr (property_pop_dot) pop_symbol = "."
  attr (property_push_dot) push_symbol = "."
  attr (property_call) push_scoped_symbol = "()", scope = @func.literal_scope
  edge @name.def -> property_pop_dot
  edge property_pop_dot -> property_push_dot
  edge property_push_dot -> property_call
  edge property_call -> @func.call
}

;; A decorated method. The decorators `property`, `abstractmethod`, and custom decorators leave
;; the method as it is, so the first parameter is `self`. A classmethod has the class as its first
;; parameter. A staticmethod has no `self`. The rules read the last decorator only.
(class_definition
    body: (block
            (decorated_definition
                (decorator (_) @decorator) .
                definition: (function_definition
                    parameters:
                        (parameters . (identifier) @first_param)
                    body: (block) @method_body
                )
            )
         )
) @class
{
  if (not (eq (source-text @decorator) "staticmethod")) {
    edge @first_param.class_member_attr_scope -> @first_param.output
    edge @first_param.output -> @method_body.after_scope
    attr (@first_param.output) push_node = @first_param
  }
  if (not (or (eq (source-text @decorator) "staticmethod") (eq (source-text @decorator) "classmethod"))) {
    edge @first_param.def -> @first_param.class_self_scope
  }
  if (eq (source-text @decorator) "classmethod") {
    edge @first_param.def -> @class.cls_call
    edge @first_param.def -> @class.cls_members_dot
    edge @first_param.def -> @class.cls_keyword_pop
  }
}

[
  (parameters        (_) @param) @params
  (lambda_parameters (_) @param) @params
]
{
  node @param.param_index
  node @param.param_name

  attr (@param.param_index) push_symbol = (named-child-index @param)
  edge @param.param_index -> @params.before_scope
  edge @params.after_scope -> @param.input
  ; A lambda body also connects to the outer scope from here. A parameter shadows that path.
  attr (@params.after_scope -> @param.input) precedence = 1
  edge @param.param_name -> @params.before_scope
}


(parameter/identifier) @param @name
{
  attr (@name.def) node_definition = @name
  attr (@param.param_name) push_node = @param
  edge @name.def -> @param.param_name
  edge @name.def -> @param.param_index
  edge @param.input -> @name.def
}

[
  (parameter/default_parameter
    name: (_) @name
    value: (_) @value) @param
  (parameter/typed_default_parameter
    name: (_) @name
    value: (_) @value) @param
] {
  attr (@name.def) node_definition = @name
  attr (@param.param_name) push_node = @name
  edge @name.def -> @param.param_name
  edge @name.def -> @param.param_index
  edge @param.input -> @name.def
  edge @name.def -> @value.output
}

[
  (parameter/typed_parameter
    . (identifier) @name) @param
  (parameter/typed_parameter
    . (list_splat_pattern
      (_) @name)) @param
  (parameter/typed_parameter
    . (dictionary_splat_pattern
      (_) @name)) @param
  (parameter/list_splat_pattern
    (_) @name) @param
  (parameter/dictionary_splat_pattern
    (_) @name) @param
] {
  attr (@name.def) node_definition = @name
  attr (@param.param_name) push_node = @name
  edge @name.def -> @param.param_name
  edge @name.def -> @param.param_index
  edge @param.input -> @name.def
}

(class_definition) @class {
  node @class.call_drop
  node @class.member_attrs
  node @class.members
  node @class.super_scope
  node @class.kw_super_scope
  node @class.init_fields
  node @class.init_fields_public
  node @class.model_scope
  node @class.model_pop
  node @class.model_pop_up
  node @class.model_up
}

(class_definition
  name: (identifier) @name) {
  attr (@name.def) node_definition = @name
}

(class_definition
  name: (identifier) @name) @class
{
  node call
  node self_dot
  node self_scope
  node members_dot

  attr (@name.def) definiens_node = @class
  attr (@name.def) syntax_type = "class"
  edge @class.after_scope -> @name.def
  ; A class definition shadows an earlier binding of the same name.
  attr (@class.after_scope -> @name.def) precedence = 1
  edge @name.def -> call
  edge @name.def -> members_dot
  edge members_dot -> @class.members
  edge call -> @class.call_drop
  edge @class.call_drop -> self_scope
  edge self_scope -> self_dot
  edge self_dot -> @class.members
  edge @class.members -> @class.member_attrs
  attr (call) pop_scoped_symbol = "()"
  attr (@class.call_drop) type = "drop_scopes"
  attr (members_dot) pop_symbol = "."
  attr (self_dot) pop_symbol = "."
  attr (@class.member_attrs) push_symbol = "."
  attr (self_scope) is_exported

  ; A classmethod makes its first parameter behave like the class. It reaches the same nodes as
  ; the name of the class does.
  let @class.cls_call = call
  let @class.cls_members_dot = members_dot

  ; A keyword argument of a call of the class names a parameter of `__init__`.
  ; Only a lookup with the marker takes this path, so a plain reference to the class does not.
  ; The path pops the marker and pushes it back. The `__init__` function pops it again.
  node keyword_pop
  let @class.cls_keyword_pop = keyword_pop
  node keyword_push
  node keyword_init
  node keyword_dot
  attr (keyword_pop) pop_symbol = "<kw>"
  attr (keyword_push) push_symbol = "<kw>"
  attr (keyword_init) push_symbol = "__init__"
  attr (keyword_dot) push_symbol = "."
  edge @name.def -> keyword_pop
  edge keyword_pop -> keyword_push
  ; An `__init__` that the class has or inherits wins over the fields of a synthesized
  ; `__init__` (precedence 1) and over the constructor of a base class (precedence 0).
  attr (keyword_pop -> keyword_push) precedence = 2
  edge keyword_push -> keyword_init
  edge keyword_init -> keyword_dot
  edge keyword_dot -> members_dot

  ; Members of the class chain to the members of its base classes.
  ; The members node has popped the "." of the lookup. The base class pops it again, so push it
  ; back first. The self scope has not popped it yet, so it needs no push.
  node members_super
  attr (members_super) push_symbol = "."
  edge @class.members -> members_super
  edge members_super -> @class.super_scope

  ; The self scope reaches the base classes only for a lookup of a member. The lookup has the "."
  ; symbol on the symbol stack. A reference to a variable that holds an instance has no "." symbol,
  ; so it does not resolve to a base class.
  node self_super
  attr (self_super) pop_symbol = "."
  edge self_scope -> self_super
  edge self_super -> members_super

  ; A member of the class shadows a member of a base class with the same name.
  ; A name in the class body shadows an attribute that a method assigns through self.
  ; The attribute lookup of a method reaches the base classes again through the self scope.
  ; The class body must shadow it too, so the class body has the highest precedence.
  attr (self_scope -> self_dot) precedence = 1
  attr (@class.members -> @class.member_attrs) precedence = 1
}

(class_definition
  body: (_) @body) @class
{
  let @body.class_member_attr_scope = @class.member_attrs
  node @body.class_parent_scope
  edge @body.class_parent_scope -> @class.class_parent_scope
  edge @body.class_parent_scope -> @class.local_scope
  let @body.class_self_scope = @class.call_drop
  let @body.class_super_scope = @class.super_scope
}

(class_definition
  body: (block
    (_) @last_stmt .)) @class
{
  edge @class.members -> @last_stmt.after_scope
  attr (@class.members -> @last_stmt.after_scope) precedence = 2
}

(class_definition
  superclasses: (argument_list
    (expression) @superclass)) @class
{
  edge @class.super_scope -> @superclass.output
}

; The keyword paths and the model questions reach the base classes through the keyword super
; scope. It leads to the super scope. A generic base class, `class B(A[T])`, is the class `A`, but
; only for these paths. A lookup of a member does not follow it: the work of the lookups would grow.
(class_definition) @class
{
  edge @class.kw_super_scope -> @class.super_scope
}

(class_definition
  superclasses: (argument_list
    (subscript
      value: (_) @value))) @class
{
  edge @class.kw_super_scope -> @value.output
}

;;;; Synthesized `__init__`
;;
;; A `@dataclass` class and a `NamedTuple` class get an `__init__` that takes the fields of the
;; class as parameters. So the name in `C(name=v)` names the field `name`. A field is a name with an
;; annotation in the class body. A `ClassVar` and a field with `field(init=False)` are no
;; parameters. The keyword path of the class pops the "<kw>" marker and looks the name up in the
;; fields. A class that writes its own `__init__` gets no synthesized `__init__`.
;;
;; The rules read the decorator by its text: `dataclass` or `dataclasses.dataclass`, with or
;; without arguments. They do not check that the name resolves to the `dataclasses` module.

(class_definition
  body: (block
    (expression_statement
      (assignment
        left: (identifier) @name
        type: (_) @_type) @_assignment))
  (#not-match? @_type "ClassVar|KW_ONLY")
  (#not-match? @_assignment "init\\s*=\\s*False|PrivateAttr")) @class
{
  edge @class.init_fields -> @name.input
}

(decorated_definition
  (decorator) @_decorator
  definition: (class_definition
    body: (block) @_body) @class
  (#match? @_decorator "^@\\s*((dataclasses|pydantic\\s*\\.\\s*dataclasses)\\s*\\.\\s*)?(dataclass|pydantic_dataclass)\\b\\s*(\\(|$)|^@\\s*(dataclasses\\s*\\.\\s*)?dataclass\\b\\s*(\\(|$)|^@\\s*(attrs?\\s*\\.\\s*)?(define|frozen|mutable)\\b\\s*(\\(|$)|^@\\s*attrs?\\s*\\.\\s*(s|attrs|attributes)\\b\\s*(\\(|$)")
  (#not-match? @_body "def\\s+__init__\\s*\\("))
{
  edge @class.cls_keyword_pop -> @class.init_fields
  attr (@class.cls_keyword_pop -> @class.init_fields) precedence = 1
}

(class_definition
  superclasses: (argument_list) @_bases
  (#match? @_bases "(^|[(,.\\s])NamedTuple\\s*($|[,)])")) @class
{
  edge @class.cls_keyword_pop -> @class.init_fields
  attr (@class.cls_keyword_pop -> @class.init_fields) precedence = 1
}

;;;; Model classes and TypedDict
;;
;; A class with a base that `dataclass_transform` marks gets a synthesized `__init__` as well. The
;; well-known bases are `pydantic.BaseModel`, `pydantic_settings.BaseSettings`, and
;; `sqlmodel.SQLModel`. A `TypedDict` class takes its fields as keyword arguments too. The rules
;; read the base by its text. A class with a base class of this kind is a model class. So is a
;; class that derives from a model class in the project, through any number of bases. A class that
;; the decorator `dataclass_transform` marks makes each class that derives from it a model class.
;; The class itself is no model class.
;;
;; A model class takes the fields of the class and of its model base classes. A field with a
;; leading underscore is a private attribute, and a `PrivateAttr` is no field. The alias of a field
;; is out of scope: the name in `Field(alias=...)` is no keyword.
;;
;; A model class that derives from a class in the project cannot tell by its text that the base
;; class is a model class. The class asks. The keyword path pushes the marker "<model>", with the
;; scope that reaches the fields of the class. The marker goes to the base classes. A base class
;; that is a root pops the marker and jumps to the scope. A base class that is no root pushes the
;; marker "<model-up>" to its own base classes. The scope stays on the scope stack.

(class_definition
  name: (identifier) @name) @class
{
  attr (@class.model_pop) pop_scoped_symbol = "<model>"
  attr (@class.model_pop_up) pop_symbol = "<model-up>"
  attr (@class.model_up) push_symbol = "<model-up>"
  edge @name.def -> @class.model_pop
  edge @name.def -> @class.model_pop_up
  edge @class.model_up -> @class.kw_super_scope
}

; A class with base classes can derive from a root: pass the question on to the base classes.
(class_definition
  superclasses: (argument_list)) @class
{
  edge @class.model_pop -> @class.model_up
  edge @class.model_pop_up -> @class.model_up
}

; A root: the base is `BaseModel`, `BaseSettings`, `SQLModel`, or `TypedDict`.
(class_definition
  superclasses: (argument_list) @_bases
  (#match? @_bases "(^|[(,.\\s])(BaseModel|BaseSettings|SQLModel|TypedDict)\\s*($|[,)\\[])")) @class
{
  edge @class.model_pop -> JUMP_TO_SCOPE_NODE
  edge @class.model_pop_up -> JUMP_TO_SCOPE_NODE
}

; A root: the decorator `dataclass_transform` marks the class.
(decorated_definition
  (decorator) @_decorator
  definition: (class_definition) @class
  (#match? @_decorator "^@\\s*([A-Za-z_][A-Za-z_0-9]*\\s*\\.\\s*)*dataclass_transform\\b"))
{
  edge @class.model_pop -> JUMP_TO_SCOPE_NODE
  edge @class.model_pop_up -> JUMP_TO_SCOPE_NODE
}

; The public fields: no leading underscore, and no `model_config`.
(class_definition
  body: (block
    (expression_statement
      (assignment
        left: (identifier) @name
        type: (_) @_type) @_assignment))
  (#not-match? @_type "ClassVar|KW_ONLY")
  (#not-match? @_assignment "init\\s*=\\s*False|PrivateAttr")
  (#not-match? @name "^_|^model_config$")) @class
{
  edge @class.init_fields_public -> @name.input
}

; A model class with a root as a base takes the public fields.
(class_definition
  superclasses: (argument_list) @_bases
  body: (block) @_body
  (#match? @_bases "(^|[(,.\\s])(BaseModel|BaseSettings|SQLModel)\\s*($|[,)\\[])")
  (#not-match? @_body "def\\s+__init__\\s*\\(")) @class
{
  edge @class.cls_keyword_pop -> @class.init_fields_public
  attr (@class.cls_keyword_pop -> @class.init_fields_public) precedence = 1
}

; A TypedDict class takes all fields.
(class_definition
  superclasses: (argument_list) @_bases
  (#match? @_bases "(^|[(,.\\s])TypedDict\\s*($|[,)\\[])")) @class
{
  edge @class.cls_keyword_pop -> @class.init_fields
  attr (@class.cls_keyword_pop -> @class.init_fields) precedence = 1
}

; A class with base classes that is no root asks its base classes.
(class_definition
  superclasses: (argument_list) @_bases
  body: (block) @_body
  (#not-match? @_bases "(^|[(,.\\s])(BaseModel|BaseSettings|SQLModel|TypedDict|NamedTuple)\\s*($|[,)\\[])")
  (#not-match? @_body "def\\s+__init__\\s*\\(")) @class
{
  node ask
  attr (ask) push_scoped_symbol = "<model>", scope = @class.model_scope
  attr (@class.model_scope) is_exported
  edge @class.cls_keyword_pop -> ask
  attr (@class.cls_keyword_pop -> ask) precedence = 1
  edge ask -> @class.kw_super_scope
  edge @class.model_scope -> @class.init_fields_public
}

; A class with no `__init__` of its own uses the constructor of its base class. That constructor can
; be a synthesized `__init__`, so the keyword path goes on to the base class with the marker.
(class_definition
  body: (block) @_body
  (#not-match? @_body "def\\s+__init__\\s*\\(")) @class
{
  node keyword_base
  attr (keyword_base) push_symbol = "<kw>"
  edge @class.cls_keyword_pop -> keyword_base
  edge keyword_base -> @class.kw_super_scope
}

(decorated_definition
  definition: (_) @def) @stmt
{
  edge @def.before_scope -> @stmt.before_scope
  edge @stmt.after_scope -> @def.after_scope
}

(match_statement) {}

(case_clause
  (case_pattern) @pattern
  consequence: (_) @consequence)
{
  edge @consequence.before_scope -> @pattern.new_bindings
}

(case_clause
  consequence: (_) @consequence) @clause
{
  edge @consequence.before_scope -> @clause.before_scope
  edge @clause.after_scope -> @consequence.after_scope
}

;;
;; #######
;; #       #    # #####  #####  ######  ####   ####  #  ####  #    #  ####
;; #        #  #  #    # #    # #      #      #      # #    # ##   # #
;; #####     ##   #    # #    # #####   ####   ####  # #    # # #  #  ####
;; #         ##   #####  #####  #           #      # # #    # #  # #      #
;; #        #  #  #      #   #  #      #    # #    # # #    # #   ## #    #
;; ####### #    # #      #    # ######  ####   ####  #  ####  #    #  ####
;;
;; Expressions

(lambda
  body: (_) @body
)@lam {
  ;; TODO Unify .before_scope, .local_scope, and .input to simplify
  ;;      uniform treatment of lambdas and function definitions.
  node @body.before_scope
  let @body.local_scope = @body.before_scope
  let @body.binding_scope = @body.before_scope
  edge @body.input -> @body.before_scope

  edge @lam.output -> @lam.call
}

(conditional_expression) {}

;;;; Assignment expressions
;;
;; `name := value` binds `name` in the enclosing function, class, or module, as an assignment does.
;; A comprehension has a scope of its own, but the name still belongs to the scope around it.
;; The binding scope is the scope of the enclosing statement, so the comprehension scope does not
;; hold the name.

(named_expression
  name: (identifier) @name
  value: (_) @value) @named
{
  attr (@name.def) node_definition = @name
  edge @named.binding_scope -> @name.def
  attr (@named.binding_scope -> @name.def) precedence = 1
  edge @name.def -> @value.output
  edge @named.output -> @value.output
}

(as_pattern) {}

(await) {}

(yield) {}

(binary_operator
  left: (_) @left
  right: (_) @right) @binop
{
  edge @binop.new_bindings -> @left.new_bindings
  edge @binop.new_bindings -> @right.new_bindings
}

(primary_expression/identifier) @name
{
  edge @name.output -> @name.local_scope
  edge @name.output -> @name.class_parent_scope
  ; A name in the local scope shadows a name in the scope around the class. That scope shadows the
  ; final bindings of the module, which an annotation can reach as a forward reference.
  attr (@name.output -> @name.local_scope) precedence = 2
  attr (@name.output -> @name.class_parent_scope) precedence = 1
  ; A name that `global` or `nonlocal` declares wins over every other binding.
  edge @name.output -> @name.declared_names
  attr (@name.output -> @name.declared_names) precedence = 3
  ; A type parameter wins over every binding of the same name outside its definition.
  edge @name.output -> @name.type_param_scope
  attr (@name.output -> @name.type_param_scope) precedence = 4
  edge @name.local_scope -> @name.input
  attr (@name.input) pop_node = @name
  ; The name of a type parameter or of a type alias at its declaration is a definition, no reference.
  attr (@name.output) push_symbol = (source-text @name), source_node = @name, is_reference = (not @name.declaration)

  edge @name.new_bindings -> @name.def
}

;;;; Literals
;;
;; A literal behaves like an instance of its builtin class, as the call `str()` does. The literal
;; pushes the "()" symbol of the class, then the name of the class. The global scope of the file
;; resolves the name in the builtins. A member of the literal, like `"a".join`, resolves to a member
;; of the class.
;;
;; A reference to a variable that holds the literal does not resolve to the class. The "()" symbol
;; stays on the symbol stack, so only a member lookup completes.

;; a string
(
  (string (string_start) @_start) @lit
  (#not-match? @_start "^([bB][rR]?|[rR][bB])")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "str"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a bytes string
(
  (string (string_start) @_start) @lit
  (#match? @_start "^([bB][rR]?|[rR][bB])")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "bytes"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; concatenated strings
(
  (concatenated_string . (string (string_start) @_start)) @lit
  (#not-match? @_start "^([bB][rR]?|[rR][bB])")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "str"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; concatenated bytes strings
(
  (concatenated_string . (string (string_start) @_start)) @lit
  (#match? @_start "^([bB][rR]?|[rR][bB])")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "bytes"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; an integer
(
  (integer) @lit
  (#not-match? @lit "[jJ]$")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "int"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a float
(
  (float) @lit
  (#not-match? @lit "[jJ]$")
)
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "float"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; an imaginary number
[
  (
    (integer) @lit
    (#match? @lit "[jJ]$")
  )
  (
    (float) @lit
    (#match? @lit "[jJ]$")
  )
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "complex"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a boolean
[
  (true) @lit
  (false) @lit
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "bool"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a list
[
  (list) @lit
  (list_comprehension) @lit
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "list"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a dictionary
[
  (dictionary) @lit
  (dictionary_comprehension) @lit
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "dict"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a set
[
  (set) @lit
  (set_comprehension) @lit
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "set"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

;; a tuple
[
  (tuple) @lit
  (expression_list) @lit
]
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @lit.literal_scope
  attr (class) push_symbol = "tuple"
  edge @lit.output -> instance
  edge instance -> class
  edge class -> @lit.global_dot
}

(none) {}

(unary_operator) {}

(attribute
  object: (_) @object
  attribute: (identifier) @name) @expr
{
  node input_dot
  node output_dot

  edge @expr.output -> @name.output
  edge @name.output -> output_dot
  edge output_dot -> @object.output
  edge @object.input -> input_dot
  edge input_dot -> @name.input
  edge @name.input -> @expr.input
  attr (output_dot) push_symbol = "."
  attr (input_dot) pop_symbol = "."
  attr (@name.input) pop_node = @name
  attr (@name.output) push_node = @name
}

(primary_expression/attribute
  attribute: (identifier) @name)
{
  attr (@name.output) is_reference
}

(subscript) {}

(call
  function: (_) @fn
  arguments: (argument_list) @args) @call
{
  node output_args

  edge @call.output -> output_args
  edge output_args -> @fn.output
  attr (output_args) push_scoped_symbol = "()", scope = @args.args
}

(call
  function: (attribute
    object: (_) @receiver)
  arguments: (argument_list
    (expression) @arg) @args)
{
  node receiver_arg_index
  attr (receiver_arg_index) pop_symbol = "0"
  edge @args.args -> receiver_arg_index
  edge receiver_arg_index -> @receiver.output

  ;; FIXME the arguments will also exist with their unshifted indices because of the general
  ;;       rule below!
  node arg_index
  attr (arg_index) pop_symbol = (plus 1 (named-child-index @arg))
  edge arg_index -> @arg.output
}

(call
  arguments: (argument_list
    (keyword_argument
      name: (identifier) @name
      value: (_) @val)) @args)
{
  node arg_name
  edge @args.args -> arg_name
  attr (arg_name) pop_node = @name
  edge arg_name -> @val.output
}

(argument_list) @args {
  node @args.args
  attr (@args.args) is_exported
}

(argument_list
  (expression) @arg) @args
{
  node arg_index
  edge @args.args -> arg_index
  attr (arg_index) pop_symbol = (named-child-index @arg)
  edge arg_index -> @arg.output
}

(
  (call
    function: (identifier) @_fn_name) @call
  (#eq? @_fn_name "super")
)
{
  edge @call.output -> @call.class_super_scope
}

(list (_) @el) @list
{
  edge @list.new_bindings -> @el.new_bindings
}

;;;; Comprehension Scopes
;;
;; A comprehension has a scope of its own. The variables of its `for` clauses belong to that scope.
;; They do not leak into the enclosing scope, and they shadow a variable of the same name outside.
;; The expressions of the comprehension look up names in the comprehension scope first.

[
  (list_comprehension)
  (set_comprehension)
  (dictionary_comprehension)
  (generator_expression)
] @comp
{
  node @comp.comprehension_scope
  edge @comp.comprehension_scope -> @comp.local_scope
}

[
  (list_comprehension (_) @child)
  (set_comprehension (_) @child)
  (dictionary_comprehension (_) @child)
  (generator_expression (_) @child)
] @comp
{
  let @child.local_scope = @comp.comprehension_scope
}

(list_comprehension) {}

(dictionary (pair) @pair) @dict
{
  edge @dict.new_bindings -> @pair.new_bindings
}

(pair
  value: (_) @value) @pair
{
  edge @pair.new_bindings -> @value.new_bindings
}

(dictionary_comprehension) {}

(set (_) @el) @set
{
  edge @set.new_bindings -> @el.new_bindings
}

(set_comprehension) {}

[
  (tuple (_) @element)
  (expression_list (_) @element)
] @tuple
{
  node el_index

  edge @tuple.output -> el_index
  attr (el_index) pop_symbol = (named-child-index @element)
  edge el_index -> @element.output

  edge @tuple.new_bindings -> @element.new_bindings
}

(parenthesized_expression (_) @inner) @paren
{
  edge @paren.output -> @inner.output
}

(generator_expression) {}

(ellipsis) {}

(list_splat (_) @splatted) @splat
{
  edge @splat.new_bindings -> @splatted.new_bindings
}

;;
;; ######
;; #     #   ##   ##### ##### ###### #####  #    #  ####
;; #     #  #  #    #     #   #      #    # ##   # #
;; ######  #    #   #     #   #####  #    # # #  #  ####
;; #       ######   #     #   #      #####  #  # #      #
;; #       #    #   #     #   #      #   #  #   ## #    #
;; #       #    #   #     #   ###### #    # #    #  ####
;;
;; Patterns


[
  (pattern/identifier) @name @pattern
  ; identifiers in patterns
  (as_pattern (identifier) @name .) @pattern
  (keyword_pattern (identifier) @name) @pattern
  (splat_pattern (identifier) @name) @pattern
  ; every context where _simple_pattern is used, because matching
  ; pattern/dotted_name does not work
  (case_pattern (dotted_name . (_) @name .) @pattern)
  (keyword_pattern (dotted_name . (_) @name .) @pattern)
  (union_pattern (dotted_name . (_) @name .) @pattern)
] {
  attr (@name.def) node_definition = @name
  edge @pattern.output -> @pattern.local_scope
  edge @pattern.output -> @pattern.class_parent_scope
  attr (@pattern.output -> @pattern.local_scope) precedence = 1
  edge @pattern.local_scope -> @pattern.input
  attr (@pattern.local_scope -> @pattern.input) precedence = 1
  attr (@pattern.input) node_definition = @name
  attr (@pattern.output) push_node = @name

  edge @pattern.new_bindings -> @name.def
}

(pattern/subscript) {}

(pattern/attribute
  attribute: (identifier) @name)
{
  attr (@name.input) is_definition
  ; The name of an assignment target is also a reference. It resolves through the object, as the
  ; name in a read of the attribute does.
  attr (@name.output) is_reference
}


(list_splat_pattern (_) @pattern) @list {
  edge @list.new_bindings -> @pattern.new_bindings
}

[
  (pattern_list (_) @pattern)
  (tuple_pattern (_) @pattern)
  (list_pattern (_) @pattern)
] @list
{
  node pattern_index

  let statement_scope = @list.local_scope
  node @pattern.local_scope
  edge statement_scope -> @pattern.local_scope
  attr (statement_scope -> @pattern.local_scope) precedence = (plus 1 (named-child-index @pattern))

  edge pattern_index -> @list.input
  edge @pattern.input -> pattern_index
  attr (pattern_index) push_symbol = (named-child-index @pattern)
}

(class_pattern (case_pattern) @pattern) @class {
  edge @class.new_bindings -> @pattern.new_bindings
}

(splat_pattern (_) @pattern) @splat {
  edge @splat.new_bindings -> @pattern.new_bindings
}

(union_pattern (_) @pattern) @union {
  edge @union.new_bindings -> @pattern.new_bindings
}

(dict_pattern (_) @pattern) @dict {
  edge @dict.new_bindings -> @pattern.new_bindings
}

(complex_pattern) {}

(as_pattern
  (expression) @value
  alias: (as_pattern_target (identifier) @name)) @as_pattern
{
  attr (@name.local_scope -> @name.input) precedence = 1
  attr (@name.input) is_definition

  edge @as_pattern.new_bindings -> @value.new_bindings
  edge @as_pattern.new_bindings -> @name.new_bindings
}

(keyword_pattern) {}

(case_pattern (_) @pattern) @case
{
  edge @case.new_bindings -> @pattern.new_bindings
}

(assignment
  left: (_) @pattern
  right: (_) @value) @assignment
{
  edge @pattern.input -> @value.output
  edge @assignment.output -> @value.output
}

(with_item
  value:
    (as_pattern
      (_) @value
      alias: (as_pattern_target (_) @pattern)))
{
  edge @pattern.input -> @value.output
}

;;
;;  #####                                      #######
;; #     # #   # #    # #####   ##   #    #       #    #   # #####  ######  ####
;; #        # #  ##   #   #    #  #   #  #        #     # #  #    # #      #
;;  #####    #   # #  #   #   #    #   ##         #      #   #    # #####   ####
;;       #   #   #  # #   #   ######   ##         #      #   #####  #           #
;; #     #   #   #   ##   #   #    #  #  #        #      #   #      #      #    #
;;  #####    #   #    #   #   #    # #    #       #      #   #      ######  ####
;;
;; Syntax Types

;;
;; BEGIN BIG GNARLY DISJUNCTION
;;
;; The following pair of rules is intended to capture the following behavior:
;;
;; If a function definition is used to define a method, by being inside a class
;; definition, then we make its syntax type `method`. Otherwise, we make it's
;; syntax type `function`. Unfortunately, because of the limitations on negation
;; and binding in tree sitter queries, we cannot negate `class_definition` or
;; similar things directly. Instead, we have to manually push the negation down
;; to form the finite disjunction it corresponds to.
;;

[
  (class_definition (block (decorated_definition (function_definition name: (_)@name))))
  (class_definition (block (function_definition name: (_)@name)))
]
{
  attr (@name.def) syntax_type = "method"
}

[
  (module (decorated_definition (function_definition name: (_)@name)))
  (module (function_definition name: (_)@name))

  (if_statement (block (decorated_definition (function_definition name: (_)@name))))
  (if_statement (block (function_definition name: (_)@name)))

  (elif_clause (block (decorated_definition (function_definition name: (_)@name))))
  (elif_clause (block (function_definition name: (_)@name)))

  (else_clause (block (decorated_definition (function_definition name: (_)@name))))
  (else_clause (block (function_definition name: (_)@name)))

  (case_clause (block (decorated_definition (function_definition name: (_)@name))))
  (case_clause (block (function_definition name: (_)@name)))

  (for_statement (block (decorated_definition (function_definition name: (_)@name))))
  (for_statement (block (function_definition name: (_)@name)))

  (while_statement (block (decorated_definition (function_definition name: (_)@name))))
  (while_statement (block (function_definition name: (_)@name)))

  (try_statement (block (decorated_definition (function_definition name: (_)@name))))
  (try_statement (block (function_definition name: (_)@name)))

  (except_clause (block (decorated_definition (function_definition name: (_)@name))))
  (except_clause (block (function_definition name: (_)@name)))

  (finally_clause (block (decorated_definition (function_definition name: (_)@name))))
  (finally_clause (block (function_definition name: (_)@name)))

  (with_statement (block (decorated_definition (function_definition name: (_)@name))))
  (with_statement (block (function_definition name: (_)@name)))

  (function_definition (block (decorated_definition (function_definition name: (_)@name))))
  (function_definition (block (function_definition name: (_)@name)))
]
{
  attr (@name.def) syntax_type = "function"
}

;;
;; END BIG GNARLY DISJUNCTION
;;

;;
;;    #
;;   # #   #    # #    #  ####  #####   ##   ##### #  ####  #    #  ####
;;  #   #  ##   # ##   # #    #   #    #  #    #   # #    # ##   # #
;; #     # # #  # # #  # #    #   #   #    #   #   # #    # # #  #  ####
;; ####### #  # # #  # # #    #   #   ######   #   # #    # #  # #      #
;; #     # #   ## #   ## #    #   #   #    #   #   # #    # #   ## #    #
;; #     # #    # #    #  ####    #   #    #   #   #  ####  #    #  ####
;;
;; Annotations

;;;; Following written annotations
;;
;; A written annotation makes a name behave like an instance of the annotated class, as a call of
;; the class does. The rules follow the written annotation only. They infer no type.
;;
;; The name pushes the "()" symbol of the class, then the class. A reference to the name still
;; resolves to the name only, because the "()" symbol stays on the symbol stack. Only a member
;; lookup, like `name.attribute`, completes in the class.
;;
;; (type).annot     node that leads to the classes that the annotation names
;;
;; An annotation follows a class name, a dotted class name, an optional type, a union type, a
;; string that holds a class name, and the container of a generic type. It does not follow the
;; element type of a generic type.

(type) @type
{
  node @type.annot
}

;; a name or a dotted name
(type [
  (identifier)
  (attribute)
] @name) @type
{
  edge @type.annot -> @name.output
}

;; An annotation can name a class that the module defines later, or the class that holds the
;; annotation. This holds for a string, and for every annotation of a module with
;; `from __future__ import annotations`. The name of an annotation reaches the final bindings of
;; the module, as the body of a function does. The scope of the name shadows these bindings.
(type (identifier) @name)
{
  edge @name.output -> @name.bottom
}

(type (attribute object: (identifier) @name))
{
  edge @name.output -> @name.bottom
}

;; the operands of a union written with "|", up to four operands
(type [
  (binary_operator left: (identifier) @name)
  (binary_operator right: (identifier) @name)
  (binary_operator left: (binary_operator left: (identifier) @name))
  (binary_operator left: (binary_operator right: (identifier) @name))
  (binary_operator left: (binary_operator left: (binary_operator left: (identifier) @name)))
  (binary_operator left: (binary_operator left: (binary_operator right: (identifier) @name)))
])
{
  edge @name.output -> @name.bottom
}

;; An annotation of a name, like `Foo[Bar]`, that the parser reads as an expression of
;; subscript, like the argument of `typing.Optional[Foo[Bar]]`. The node follows the classes that
;; the subscript names. Another rule connects it to the head, the wrapped type, or the members.
(subscript) @sub
{
  node @sub.annot
}

(type (subscript) @sub) @type
{
  edge @type.annot -> @sub.annot
}

;; a generic type, like typing.List[Foo] or List[Foo]: follow the container only
(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ] @head
  (#not-match? @_head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly|Union)$")) @sub
{
  edge @sub.annot -> @head.output
}

;; a wrapper of a type, like typing.Optional[Foo]: follow the first argument
(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  .
  subscript: [(identifier) (attribute)] @argument
  (#match? @_head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly)$")) @sub
{
  edge @sub.annot -> @argument.output
}

(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  .
  subscript: [(subscript) (binary_operator)] @argument
  (#match? @_head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly)$")) @sub
{
  edge @sub.annot -> @argument.annot
}

;; a union type, like typing.Union[Foo, Bar]: follow every argument
(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  subscript: [(identifier) (attribute)] @argument
  (#eq? @_head "Union")) @sub
{
  edge @sub.annot -> @argument.output
}

(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  subscript: [(subscript) (binary_operator)] @argument
  (#eq? @_head "Union")) @sub
{
  edge @sub.annot -> @argument.annot
}

;; a string that holds a class name, like "Foo"
(type
  (string
    (string_content) @content
    (#match? @content "^[A-Za-z_][A-Za-z0-9_]*$"))) @type
{
  node reference
  attr (reference) node_reference = @content
  edge reference -> @content.local_scope
  attr (reference -> @content.local_scope) precedence = 2
  edge reference -> @content.class_parent_scope
  attr (reference -> @content.class_parent_scope) precedence = 1
  edge reference -> @content.bottom
  edge @type.annot -> reference
}

;; a string that holds a class name, as the first argument of a wrapper, like typing.Optional["Foo"]
(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  .
  subscript: (string
    (string_content) @content
    (#match? @content "^[A-Za-z_][A-Za-z0-9_]*$"))
  (#match? @_head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly)$")) @sub
{
  node reference
  attr (reference) node_reference = @content
  edge reference -> @content.local_scope
  attr (reference -> @content.local_scope) precedence = 2
  edge reference -> @content.class_parent_scope
  attr (reference -> @content.class_parent_scope) precedence = 1
  edge reference -> @content.bottom
  edge @sub.annot -> reference
}

;; a string that holds a class name, as an argument of a union, like typing.Union["Foo", Bar]
(subscript
  value: [
    (identifier) @_head
    (attribute attribute: (identifier) @_head)
  ]
  subscript: (string
    (string_content) @content
    (#match? @content "^[A-Za-z_][A-Za-z0-9_]*$"))
  (#eq? @_head "Union")) @sub
{
  node reference
  attr (reference) node_reference = @content
  edge reference -> @content.local_scope
  attr (reference -> @content.local_scope) precedence = 2
  edge reference -> @content.class_parent_scope
  attr (reference -> @content.class_parent_scope) precedence = 1
  edge reference -> @content.bottom
  edge @sub.annot -> reference
}

;; a wrapper of a type, like Optional[Foo]: follow the first type argument
(type
  (generic_type
    . (identifier) @_head
    . (type_parameter . (type) @argument)
    (#match? @_head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly)$"))) @type
{
  edge @type.annot -> @argument.annot
}

;; a union type, like Union[Foo, Bar]: follow every type argument
(type
  (generic_type
    . (identifier) @_head
    . (type_parameter (type) @argument)
    (#eq? @_head "Union"))) @type
{
  edge @type.annot -> @argument.annot
}

;; a generic type, like List[Foo]: follow the container only
(type
  (generic_type
    . (identifier) @head
    (#not-match? @head "^(Optional|ClassVar|Final|Annotated|Required|NotRequired|ReadOnly|Union)$"))) @type
{
  attr (@head.output) push_symbol = (source-text @head), source_node = @head, is_reference = (not @head.declaration)
  edge @head.output -> @head.local_scope
  attr (@head.output -> @head.local_scope) precedence = 2
  edge @head.output -> @head.class_parent_scope
  attr (@head.output -> @head.class_parent_scope) precedence = 1
  edge @head.output -> @head.bottom
  edge @head.output -> @head.type_param_scope
  attr (@head.output -> @head.type_param_scope) precedence = 4
  edge @type.annot -> @head.output
}

;; a union written with "|", like Foo | None
(binary_operator operator: "|") @union
{
  node @union.annot
}

(type (binary_operator operator: "|") @union) @type
{
  edge @type.annot -> @union.annot
}

(binary_operator left: [(identifier) (attribute)] @operand operator: "|") @union
{
  edge @union.annot -> @operand.output
}

(binary_operator operator: "|" right: [(identifier) (attribute)] @operand) @union
{
  edge @union.annot -> @operand.output
}

(binary_operator left: (binary_operator operator: "|") @operand operator: "|") @union
{
  edge @union.annot -> @operand.annot
}

(binary_operator operator: "|" right: (binary_operator operator: "|") @operand) @union
{
  edge @union.annot -> @operand.annot
}

;; a generic type in a union, like List[Foo] | None: follow the container only
(binary_operator left: (subscript) @operand operator: "|") @union
{
  edge @union.annot -> @operand.annot
}

(binary_operator operator: "|" right: (subscript) @operand) @union
{
  edge @union.annot -> @operand.annot
}

;; a union that the parser reads as a union type, like list[Foo] | None
(type (union_type (type) @member)) @type
{
  edge @type.annot -> @member.annot
}

;;;; Annotated names
;;
;; The annotation of a parameter, a variable, or an attribute.

[
  (parameter/typed_parameter . (identifier) @name type: (type) @type)
  (parameter/typed_default_parameter name: (identifier) @name type: (type) @type)
]
{
  node instance
  attr (instance) push_scoped_symbol = "()", scope = @name.literal_scope
  edge @name.def -> instance
  edge instance -> @type.annot
}

;; `x: Foo = value`, `x: Foo`, and `self.x: Foo = value`
(assignment left: (_) @pattern type: (type) @type)
{
  node instance
  attr (instance) push_scoped_symbol = "()", scope = @pattern.literal_scope
  edge @pattern.input -> instance
  edge instance -> @type.annot
}

;;;; Annotated splat parameters
;;
;; The annotation of `*args: T` describes each element, so `args` is a tuple. The annotation of
;; `**kwargs: T` describes each value, so `kwargs` is a dict. The rules follow neither element type.

(parameter/typed_parameter . (list_splat_pattern (identifier) @name))
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @name.literal_scope
  attr (class) push_symbol = "tuple"
  edge @name.def -> instance
  edge instance -> class
  edge class -> @name.global_dot
}

(parameter/typed_parameter . (dictionary_splat_pattern (identifier) @name))
{
  node instance
  node class
  attr (instance) push_scoped_symbol = "()", scope = @name.literal_scope
  attr (class) push_symbol = "dict"
  edge @name.def -> instance
  edge instance -> class
  edge class -> @name.global_dot
}

;;;; Return annotations
;;
;; `def make() -> Foo` makes a call of `make` behave like an instance of Foo.

(function_definition return_type: (type) @type) @func
{
  node instance
  attr (instance) push_scoped_symbol = "()", scope = @func.literal_scope
  edge @func.function_returns -> instance
  edge instance -> @type.annot
}
